  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.9",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.12",
    "expo-build-properties": "^57.0.12",
    "expo-constants": "~57.0.10",
    "expo-linking": "~57.0.5",
